{
  "fhirVersion": "5.0.0",
  "url": "http://hl7.org/fhir/StructureDefinition/Annotation",
  "type": "Annotation",
  "name": "Annotation",
  "kind": "complex-type",
  "derivation": "specialization",
  "required": [
    "text"
  ],
  "constraints": [
    {
      "key": "ele-1",
      "severity": "error",
      "expression": "hasValue() or (children().count() \u003E id.count())",
      "human": "All FHIR elements must have a @value or children"
    }
  ],
  "elements": {
    "author": {
      "path": "Annotation.author[x]",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "Reference",
        "string"
      ],
      "choices": [
        "authorReference",
        "authorString"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    },
    "extension": {
      "path": "Annotation.extension",
      "min": 0,
      "max": "*",
      "array": true,
      "type": [
        "Extension"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        },
        {
          "key": "ext-1",
          "severity": "error",
          "expression": "extension.exists() != value.exists()",
          "human": "Must have either extensions or value[x], not both"
        }
      ]
    },
    "id": {
      "path": "Annotation.id",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "http://hl7.org/fhirpath/System.String"
      ]
    },
    "text": {
      "path": "Annotation.text",
      "min": 1,
      "max": 1,
      "array": false,
      "type": [
        "markdown"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    },
    "time": {
      "path": "Annotation.time",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "dateTime"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    }
  }
}