{
  "fhirVersion": "5.0.0",
  "url": "http://hl7.org/fhir/StructureDefinition/Narrative",
  "type": "Narrative",
  "name": "Narrative",
  "kind": "complex-type",
  "derivation": "specialization",
  "required": [
    "div",
    "status"
  ],
  "constraints": [
    {
      "key": "ele-1",
      "severity": "error",
      "expression": "hasValue() or (children().count() \u003E id.count())",
      "human": "All FHIR elements must have a @value or children"
    }
  ],
  "elements": {
    "div": {
      "path": "Narrative.div",
      "min": 1,
      "max": 1,
      "array": false,
      "type": [
        "xhtml"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        },
        {
          "key": "txt-1",
          "severity": "error",
          "expression": "htmlChecks()",
          "human": "The narrative SHALL contain only the basic html formatting elements and attributes described in chapters 7-11 (except section 4 of chapter 9) and 15 of the HTML 4.0 standard, \u003Ca\u003E elements (either name or href), images and internally contained style attributes"
        },
        {
          "key": "txt-2",
          "severity": "error",
          "expression": "htmlChecks()",
          "human": "The narrative SHALL have some non-whitespace content"
        }
      ]
    },
    "extension": {
      "path": "Narrative.extension",
      "min": 0,
      "max": "*",
      "array": true,
      "type": [
        "Extension"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        },
        {
          "key": "ext-1",
          "severity": "error",
          "expression": "extension.exists() != value.exists()",
          "human": "Must have either extensions or value[x], not both"
        }
      ]
    },
    "id": {
      "path": "Narrative.id",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "http://hl7.org/fhirpath/System.String"
      ]
    },
    "status": {
      "path": "Narrative.status",
      "min": 1,
      "max": 1,
      "array": false,
      "type": [
        "code"
      ],
      "binding": {
        "strength": "required",
        "valueSet": "http://hl7.org/fhir/ValueSet/narrative-status|5.0.0"
      },
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    }
  }
}