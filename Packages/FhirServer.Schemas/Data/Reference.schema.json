{
  "fhirVersion": "5.0.0",
  "url": "http://hl7.org/fhir/StructureDefinition/Reference",
  "type": "Reference",
  "name": "Reference",
  "kind": "complex-type",
  "derivation": "specialization",
  "required": [],
  "constraints": [
    {
      "key": "ele-1",
      "severity": "error",
      "expression": "hasValue() or (children().count() \u003E id.count())",
      "human": "All FHIR elements must have a @value or children"
    },
    {
      "key": "ref-1",
      "severity": "error",
      "expression": "reference.exists()  implies (reference.startsWith(\u0027#\u0027).not() or (reference.substring(1).trace(\u0027url\u0027) in %rootResource.contained.id.trace(\u0027ids\u0027)) or (reference=\u0027#\u0027 and %rootResource!=%resource))",
      "human": "SHALL have a contained resource if a local reference is provided"
    },
    {
      "key": "ref-2",
      "severity": "error",
      "expression": "reference.exists() or identifier.exists() or display.exists() or extension.exists()",
      "human": "At least one of reference, identifier and display SHALL be present (unless an extension is provided)."
    }
  ],
  "elements": {
    "display": {
      "path": "Reference.display",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "string"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    },
    "extension": {
      "path": "Reference.extension",
      "min": 0,
      "max": "*",
      "array": true,
      "type": [
        "Extension"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        },
        {
          "key": "ext-1",
          "severity": "error",
          "expression": "extension.exists() != value.exists()",
          "human": "Must have either extensions or value[x], not both"
        }
      ]
    },
    "id": {
      "path": "Reference.id",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "http://hl7.org/fhirpath/System.String"
      ]
    },
    "identifier": {
      "path": "Reference.identifier",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "Identifier"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    },
    "reference": {
      "path": "Reference.reference",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "string"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    },
    "type": {
      "path": "Reference.type",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "uri"
      ],
      "binding": {
        "strength": "extensible",
        "valueSet": "http://hl7.org/fhir/ValueSet/resource-types"
      },
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    }
  }
}