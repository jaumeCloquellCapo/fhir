<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FhirServer.Schemas</RootNamespace>
    <Description>Generated FHIR R5 schema JSON + resource catalog (Firely-free).</Description>
    <IsPackable>true</IsPackable>
    <Version>5.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated/GeneratedResourceCatalog.fs" />
    <Compile Include="SchemaPackage.fs" />
  </ItemGroup>

  <!-- LogicalName = filename so the validator can find Patient.schema.json / valuesets.json -->
  <ItemGroup>
    <EmbeddedResource Include="Data\*.schema.json">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\valuesets.json">
      <LogicalName>valuesets.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
