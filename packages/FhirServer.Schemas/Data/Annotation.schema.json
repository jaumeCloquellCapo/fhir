{
  "fhirVersion": "5.0.0",
  "url": "http://hl7.org/fhir/StructureDefinition/Annotation",
  "type": "Annotation",
  "name": "Annotation",
  "kind": "complex-type",
  "derivation": "specialization",
  "required": [
    "text"
  ],
  "elements": {
    "author": {
      "path": "Annotation.author[x]",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "Reference",
        "string"
      ],
      "choices": [
        "authorReference",
        "authorString"
      ]
    },
    "extension": {
      "path": "Annotation.extension",
      "min": 0,
      "max": "*",
      "array": true,
      "type": [
        "Extension"
      ]
    },
    "id": {
      "path": "Annotation.id",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "http://hl7.org/fhirpath/System.String"
      ]
    },
    "text": {
      "path": "Annotation.text",
      "min": 1,
      "max": 1,
      "array": false,
      "type": [
        "markdown"
      ]
    },
    "time": {
      "path": "Annotation.time",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "dateTime"
      ]
    }
  }
}