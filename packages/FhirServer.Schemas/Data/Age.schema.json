  "kind": "complex-type",
  "derivation": "specialization",
  "required": [],
  "constraints": [
    {
      "key": "age-1",
      "severity": "error",
      "expression": "(code.exists() or value.empty()) and (system.empty() or system = %ucum) and (value.empty() or value.hasValue().not() or value \u003E 0)",
      "human": "There SHALL be a code if there is a value and it SHALL be an expression of time.  If system is present, it SHALL be UCUM.  If value is present, it SHALL be positive."
    },
    {
      "key": "ele-1",
      "severity": "error",
      "expression": "hasValue() or (children().count() \u003E id.count())",
      "human": "All FHIR elements must have a @value or children"
    },
    {
      "key": "qty-3",
      "severity": "error",
      "expression": "code.empty() or system.exists()",
      "human": "If a code for the unit is present, the system SHALL also be present"
