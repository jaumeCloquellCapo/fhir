{
  "fhirVersion": "5.0.0",
  "url": "http://hl7.org/fhir/StructureDefinition/Range",
  "type": "Range",
  "name": "Range",
  "kind": "complex-type",
  "derivation": "specialization",
  "required": [],
  "constraints": [
    {
      "key": "ele-1",
      "severity": "error",
      "expression": "hasValue() or (children().count() \u003E id.count())",
      "human": "All FHIR elements must have a @value or children"
    },
    {
      "key": "rng-2",
      "severity": "error",
      "expression": "low.value.empty() or high.value.empty() or low.lowBoundary().comparable(high.highBoundary()).not() or (low.lowBoundary() \u003C= high.highBoundary())",
      "human": "If present, low SHALL have a lower value than high"
    }
  ],
  "elements": {
    "extension": {
      "path": "Range.extension",
      "min": 0,
      "max": "*",
      "array": true,
      "type": [
        "Extension"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        },
        {
          "key": "ext-1",
          "severity": "error",
          "expression": "extension.exists() != value.exists()",
          "human": "Must have either extensions or value[x], not both"
        }
      ]
    },
    "high": {
      "path": "Range.high",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "Quantity"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    },
    "id": {
      "path": "Range.id",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "http://hl7.org/fhirpath/System.String"
      ]
    },
    "low": {
      "path": "Range.low",
      "min": 0,
      "max": 1,
      "array": false,
      "type": [
        "Quantity"
      ],
      "constraints": [
        {
          "key": "ele-1",
          "severity": "error",
          "expression": "hasValue() or (children().count() \u003E id.count())",
          "human": "All FHIR elements must have a @value or children"
        }
      ]
    }
  }
}