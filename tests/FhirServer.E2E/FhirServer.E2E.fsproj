<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FhirApiFactory.fs" />
    <Compile Include="HttpAssert.fs" />
    <Compile Include="Endpoints/RootHealthVersionTests.fs" />
    <Compile Include="Endpoints/MetadataTests.fs" />
    <Compile Include="Endpoints/ValidateTests.fs" />
    <Compile Include="Endpoints/CrudTests.fs" />
    <Compile Include="Endpoints/SearchHistoryBundleTests.fs" />
    <Compile Include="Endpoints/SearchIndexTests.fs" />
    <Compile Include="Endpoints/SearchAdvancedTests.fs" />
    <Compile Include="Endpoints/IncludeEverythingDumpTests.fs" />
    <Compile Include="Endpoints/RevincludeChainExportTests.fs" />
    <Compile Include="Endpoints/ImportDocumentTests.fs" />
    <Compile Include="Endpoints/SmartSubscriptionTests.fs" />
    <Compile Include="Endpoints/AuditTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FhirServer\FhirServer.fsproj" />
  </ItemGroup>

</Project>
