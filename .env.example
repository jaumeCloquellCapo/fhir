# Copy to `.env` (gitignored) for machine-specific overrides, or use `.env.dev` for local Compose.
# Nested ASP.NET keys use `__` (e.g. ConnectionStrings:Fhir → ConnectionStrings__Fhir).

# PostgreSQL — matches `make db-up` (user/db/password: fhir). Change outside disposable local use.
ConnectionStrings__Fhir=Host=localhost;Port=5432;Database=fhir;Username=fhir;Password=fhir
