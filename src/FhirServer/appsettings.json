{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Fhir": "Host=localhost;Port=5432;Database=fhir;Username=fhir;Password=fhir"
  },
  "Auth": {
    "Enabled": false,
    "Username": "fhir",
    "Password": "change-me"
  },
  "Smart": {
    "Enabled": true,
    "TokenLifetimeMinutes": 60,
    "AuthCodeLifetimeMinutes": 5,
    "Clients": [
      {
        "ClientId": "fhir-client",
        "ClientSecret": "change-me",
        "AllowedScopes": "system/*.read system/*.write system/*.cruds openid fhirUser",
        "GrantTypes": "client_credentials authorization_code",
        "RedirectUris": [ "http://localhost/callback", "http://127.0.0.1/callback" ]
      },
      {
        "ClientId": "patient-app",
        "ClientSecret": "change-me",
        "AllowedScopes": "openid fhirUser launch/patient patient/*.rs patient/*.read",
        "GrantTypes": "authorization_code",
        "RedirectUris": [ "http://localhost:3000/callback", "http://127.0.0.1/callback" ]
      }
    ]
  },
  "Audit": {
    "Enabled": false
  }
}
