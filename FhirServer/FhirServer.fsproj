<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FhirServer</RootNamespace>
    <!-- Fail on known NuGet advisories; F# FS0052/FS1178 noise left as warnings for now. -->
    <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Hexagonal / DDD compile order: Domain → Application → Infrastructure → Composition -->
  <ItemGroup>
    <!-- Domain (core) -->
    <Compile Include="Domain/Model/Types.fs" />
    <Compile Include="Domain/Model/FhirJson.fs" />
    <Compile Include="Domain/Model/ResourceCatalog.fs" />
    <Compile Include="Domain/Services/QueryParams.fs" />
    <Compile Include="Domain/Services/TenantContext.fs" />
    <Compile Include="Domain/Services/OrganizationHierarchy.fs" />
    <Compile Include="Domain/Services/SearchFilter.fs" />
    <Compile Include="Domain/Services/SearchEngine.fs" />
    <Compile Include="Domain/Services/SearchIndexer.fs" />
    <Compile Include="Domain/Ports/IResourceStore.fs" />
    <Compile Include="Domain/Services/ReferenceValidation.fs" />
    <Compile Include="Domain/Services/ResourceValidator.fs" />

    <!-- Application (use cases) -->
    <Compile Include="Application/Smart/SmartScopes.fs" />
    <Compile Include="Application/Smart/SmartClients.fs" />
    <Compile Include="Application/Smart/PatientCompartment.fs" />
    <Compile Include="Application/Smart/SmartAuth.fs" />
    <Compile Include="Application/Subscriptions/SubscriptionNotifier.fs" />
    <Compile Include="Application/Terminology/TerminologyOps.fs" />
    <Compile Include="Application/Resources/ResourceHelpers.fs" />
    <Compile Include="Application/Resources/ResourceCrud.fs" />
    <Compile Include="Application/Resources/ResourceSearch.fs" />
    <Compile Include="Application/Resources/ResourceHistory.fs" />
    <Compile Include="Application/Resources/ResourceOperations.fs" />
    <Compile Include="Application/Resources/ResourceBundle.fs" />
    <Compile Include="Application/ResourceHandlers.fs" />
    <Compile Include="Application/BulkExport.fs" />
    <Compile Include="Application/BulkImport.fs" />
    <Compile Include="Application/Audit/BalpAuditEventBuilder.fs" />
    <Compile Include="Application/Audit/AuditRecorder.fs" />

    <!-- Infrastructure — persistence -->
    <Compile Include="Infrastructure/Persistence/MigrationRunner.fs" />
    <Compile Include="Infrastructure/Persistence/EnvelopeCodec.fs" />
    <Compile Include="Infrastructure/Persistence/EnvelopeDialect.fs" />
    <Compile Include="Infrastructure/Persistence/SearchIndexQuery.fs" />
    <Compile Include="Infrastructure/Persistence/EnvelopeResourceStore.fs" />
    <Compile Include="Infrastructure/Persistence/Postgres/PostgresMigrations.fs" />
    <Compile Include="Infrastructure/Persistence/Postgres/PostgresEnvelopeSession.fs" />

    <!-- Infrastructure — inbound adapters -->
    <Compile Include="Infrastructure/Capability/Metadata.fs" />
    <Compile Include="Infrastructure/Http/Codec.fs" />
    <Compile Include="Infrastructure/Http/Responses.fs" />
    <Compile Include="Infrastructure/Http/Auth.fs" />
    <Compile Include="Infrastructure/Http/AuditMiddleware.fs" />
    <Compile Include="Infrastructure/Http/OpenApiDocs.fs" />
    <Compile Include="Infrastructure/Http/DotEnv.fs" />
    <Compile Include="Infrastructure/Http/HttpRequestHelpers.fs" />
    <Compile Include="Infrastructure/Http/Routes/SystemRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/SmartAuthRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/HookRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/BulkRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/HistoryBundleRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/TerminologyRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/OperationRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/CrudRoutes.fs" />
    <Compile Include="Infrastructure/Http/Routes/OrgBacRoutes.fs" />

    <!-- Composition root -->
    <Compile Include="AppHost.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packages\FhirServer.Schemas\FhirServer.Schemas.fsproj" />
    <ProjectReference Include="..\Packages\FhirServer.Validation\FhirServer.Validation.fsproj" />
  </ItemGroup>

</Project>
